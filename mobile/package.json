{
  "name": "yardscout-android",
  "private": true,
  "version": "0.1.0",
  "description": "Android wrapper for YardScout",
  "scripts": {
    "cap": "cap",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android:sync": "cap sync android",
    "android:run": "cap run android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:lint": "cd android && gradlew.bat lint",
    "android:test": "cd android && gradlew.bat test"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
